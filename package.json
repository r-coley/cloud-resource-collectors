{
  "name": "cloud-resource-collectors",
  "version": "0.1.0",
  "description": "Read-only Azure, AWS and GCP resource discovery with a shared JSON inventory contract",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cloud-collect": "bin/cloud-collect.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "demo": "node scripts/demo.js"
  },
  "dependencies": {
    "ajv": "8.17.1"
  },
  "files": [
    "bin/",
    "src/",
    "cloud-inventory.schema.json",
    "examples/",
    "docs/",
    "README.md",
    "CONTRACT.txt",
    "AZURE-README.txt",
    "AWS-README.txt",
    "GCP-README.txt",
    "azure-discover.js",
    "aws-discover.js",
    "gcp-discover.js",
    "graph/",
    "PROVENANCE.md",
    "scripts/",
    "tests/",
    "AZURE-REUSE.txt",
    "cross-cloud-reuse.txt"
  ]
}
